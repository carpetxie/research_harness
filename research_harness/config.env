# ── Research Harness Configuration ────────────────────────────────────────────
# Fill these in before running scripts/research_loop.sh.
# The loop script sources this file — all prompts and logs use these values.

# The research domain / subject matter (one phrase, e.g. "prediction markets")
TOPIC="your research topic"

# Full title of the paper being produced
PAPER_TITLE="Your Paper Title"

# The central research question the paper answers
RESEARCH_QUESTION="Your central research question"

# Name of the primary data source (e.g. "Kalshi API", "Bloomberg", "FRED")
DATA_SOURCE_NAME="Your Data Source"

# Where the finished paper will be published (informs critiquer lens)
PUBLICATION_VENUE="your research blog or journal"

# Claude model to use (opus | sonnet | haiku). opus is recommended for research.
MODEL="opus"

# Maximum iterations per loop run (can be overridden as CLI arg)
MAX_ITERATIONS=5
